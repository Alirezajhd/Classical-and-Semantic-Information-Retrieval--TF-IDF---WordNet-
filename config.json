{
  "student_name": "Alireza Jahedi",
  "student_id": "40435338",
  "preprocessing": {
    "lowercase": true,
    "remove_stopwords": true,
    "stemming": true,
    "lemmatize": false,
    "min_token_length": 2,
    "stopword_source": "nltk"
  },
  "indexing": {
    "use_stemming_in_index": true,
    "use_lemmatization_in_index": false,
    "title_weight": 3.0
  },
  "retrieval": {
    "topk": 100,
    "tf_weight": "sublinear",
    "idf_weight": "smooth",
    "normalization": "cosine"
  },
  "semantic": {
    "enabled": true,
    "mode": "rerank",
    "alpha": 0.6,
    "rerank_k": 20,
    "max_synsets_per_word": 2,
    "max_doc_content_words": 100,
    "pos_tags": ["NOUN", "VERB"],
    "similarity_metric": "wup",
    "cache_enabled": true,
    "cache_path": "results/extra/wordnet_sim_cache.pkl",
    "normalize_scores": true,
    "alpha_mode": "fixed",
    "alpha_min": 0.5,
    "alpha_max": 0.95
  },
  "ltr": {
    "enabled": true,
    "model": "ridge",
    "lambda": 1.0,
    "rerank_k": 20,
    "cv_folds": 5
  },
  "evaluation": {
    "metrics": ["MAP", "MRR", "P@1", "P@5", "P@10", "NDCG@5", "NDCG@10"],
    "relevance_binary": true
  },
  "output": {
    "outdir": "results",
    "overwrite": true,
    "verbose": true,
    "save_intermediate": true
  },
  "analysis": {
    "run_alpha_sweep": true,
    "alpha_values": [0.0, 0.2, 0.4, 0.6, 0.75, 0.8, 0.85, 0.9, 1.0],
    "run_ablation": true,
    "ablation_tests": ["stopwords", "stemming", "overlap_vs_tfidf", "semantic", "score_normalization"],
    "title_weight_values": [1.0, 2.0, 3.0, 5.0, 8.0, 15.0]
  },
  "random_seed": 42
}